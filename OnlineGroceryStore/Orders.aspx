<%@ Page Title="My orders" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeFile="Orders.aspx.vb" Inherits="OrdersPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading"><span class="eyebrow">FROM OUR STORE TO YOUR DOOR</span><h1>My orders</h1><p>View your order history and current delivery status.</p></div><div class="table-responsive"><asp:GridView ID="OrdersGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." ><Columns><asp:BoundField DataField="OrderID" HeaderText="Order #" /><asp:BoundField DataField="OrderDate" HeaderText="Date" DataFormatString="{0:dd MMM yyyy HH:mm}" /><asp:BoundField DataField="TotalAmount" HeaderText="Total" DataFormatString="{0:C2}" /><asp:BoundField DataField="PaymentMethod" HeaderText="Payment" /><asp:BoundField DataField="Status" HeaderText="Status" /><asp:HyperLinkField Text="View details →" DataNavigateUrlFields="OrderID" DataNavigateUrlFormatString="~/OrderDetails.aspx?id={0}" HeaderText="Details" /></Columns></asp:GridView></div>
</asp:Content>
