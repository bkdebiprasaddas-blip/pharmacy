<%@ Page Title="Shop groceries" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeFile="Products.aspx.vb" Inherits="ProductsPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading"><span class="eyebrow">FILL YOUR BASKET</span><h1>Shop groceries</h1><p>Fresh finds and cupboard favourites, all in one place.</p></div><div class="filter-bar"><div class="field"><asp:Label runat="server" AssociatedControlID="Search" Text="Search product or brand" /><asp:TextBox ID="Search" runat="server" CssClass="form-control" MaxLength="100" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Category" Text="Category" /><asp:DropDownList ID="Category" runat="server" CssClass="form-select" /></div><asp:Button ID="SaveButton" runat="server" Text="Find products" CssClass="btn btn-primary" OnClick="SearchClick" CausesValidation="false" /></div><asp:Repeater ID="ProductList" runat="server"><HeaderTemplate><div class="product-grid"></HeaderTemplate><ItemTemplate>
<article class="product-card"><a href='<%# ResolveUrl("~/ProductDetails.aspx?id=" & Eval("ProductID").ToString()) %>'><img src='<%# CommonHelper.ProductImage(Eval("ImagePath")) %>' alt="Grocery product" loading="lazy" /></a><div class="product-card-body"><span class="eyebrow"><%#: Eval("CategoryName") %></span><h3><%#: Eval("ProductName") %></h3><p class="muted"><%#: Eval("Brand") %> · <%#: Eval("Unit") %></p><div class="price-row"><strong><%#: CommonHelper.FormatCurrency(Eval("Price")) %></strong><span><%#: Eval("StockQuantity") %> in stock</span></div><a class="btn btn-outline-primary" href='<%# ResolveUrl("~/ProductDetails.aspx?id=" & Eval("ProductID").ToString()) %>'>View &amp; add to cart →</a></div></article>
</ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater><asp:Label ID="EmptyLabel" runat="server" CssClass="muted" />
</asp:Content>
