<%@ Page Title="Edit product" Language="VB" MasterPageFile="~/Admin/AdminMaster.master" AutoEventWireup="false" CodeFile="EditProduct.aspx.vb" Inherits="Admin_EditProductPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<a href="ManageProducts.aspx">← Products &amp; inventory</a><div class="form-panel"><h1>Edit product</h1><asp:ValidationSummary runat="server" CssClass="validation" /><div class="form-grid"><div class="field"><asp:Label runat="server" AssociatedControlID="ProductName" Text="Product name" /><asp:TextBox ID="ProductName" runat="server" CssClass="form-control" MaxLength="150" /><asp:RequiredFieldValidator runat="server" ControlToValidate="ProductName" ErrorMessage="Product name is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Category" Text="Active category" /><asp:DropDownList ID="Category" runat="server" CssClass="form-select" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Brand" Text="Brand" /><asp:TextBox ID="Brand" runat="server" CssClass="form-control" MaxLength="100" /><asp:RequiredFieldValidator runat="server" ControlToValidate="Brand" ErrorMessage="Brand is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Unit" Text="Unit (e.g. 1 kg or 500 ml)" /><asp:TextBox ID="Unit" runat="server" CssClass="form-control" MaxLength="40" /><asp:RequiredFieldValidator runat="server" ControlToValidate="Unit" ErrorMessage="Unit (e.g. 1 kg or 500 ml) is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Price" Text="Price (₹)" /><asp:TextBox ID="Price" runat="server" CssClass="form-control" MaxLength="12" /><asp:RequiredFieldValidator runat="server" ControlToValidate="Price" ErrorMessage="Price (₹) is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Stock" Text="Stock quantity" /><asp:TextBox ID="Stock" runat="server" CssClass="form-control" MaxLength="7" TextMode="Number" /><asp:RequiredFieldValidator runat="server" ControlToValidate="Stock" ErrorMessage="Stock quantity is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Expiry" Text="Expiry date" /><asp:TextBox ID="Expiry" runat="server" CssClass="form-control" MaxLength="10" TextMode="Date" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Status" Text="Status" /><asp:DropDownList ID="Status" runat="server" CssClass="form-select"><asp:ListItem>Active</asp:ListItem><asp:ListItem>Inactive</asp:ListItem></asp:DropDownList></div><div class="field"><asp:Label runat="server" AssociatedControlID="Description" Text="Description" /><asp:TextBox ID="Description" runat="server" CssClass="form-control" MaxLength="4000" TextMode="MultiLine" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="ImagePath" Text="Local product image path" /><asp:TextBox ID="ImagePath" runat="server" CssClass="form-control" MaxLength="255" /></div></div><p class="muted">Copy a JPG, PNG, or WebP to Images/Products, then enter ~/Images/Products/filename.jpg. Leave blank for the default illustration. File uploads are intentionally disabled.</p><asp:Button ID="SaveButton" runat="server" Text="Save product" CssClass="btn btn-primary" OnClick="SaveClick" CausesValidation="true" /></div>
</asp:Content>
