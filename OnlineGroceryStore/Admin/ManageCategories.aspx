<%@ Page Title="Manage categories" Language="VB" MasterPageFile="~/Admin/AdminMaster.master" AutoEventWireup="false" CodeFile="ManageCategories.aspx.vb" Inherits="Admin_ManageCategoriesPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<h1>Categories</h1><p>Deactivate categories to hide their products from shopping. Only empty categories can be deleted.</p><div class="table-responsive"><asp:GridView ID="CategoriesGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." OnRowCommand="CategoryCommand"><Columns><asp:BoundField DataField="CategoryID" HeaderText="ID" /><asp:BoundField DataField="CategoryName" HeaderText="Name" /><asp:BoundField DataField="Description" HeaderText="Description" /><asp:BoundField DataField="Status" HeaderText="Status" /><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:LinkButton runat="server" CommandName="LoadCategory" CommandArgument='<%# Eval("CategoryID") %>' Text="Edit" CausesValidation="false" /> · <asp:LinkButton runat="server" CommandName="RemoveCategory" CommandArgument='<%# Eval("CategoryID") %>' Text="Delete" CausesValidation="false" OnClientClick="return confirm('Delete this unused category?');" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div><div class="form-panel"><h2><asp:Literal ID="EditorTitle" runat="server" Text="Add category" Mode="Encode" /></h2><asp:ValidationSummary runat="server" CssClass="validation" /><div class="field"><asp:Label runat="server" AssociatedControlID="CategoryName" Text="Category name" /><asp:TextBox ID="CategoryName" runat="server" CssClass="form-control" MaxLength="100" /><asp:RequiredFieldValidator runat="server" ControlToValidate="CategoryName" ErrorMessage="Category name is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Description" Text="Description" /><asp:TextBox ID="Description" runat="server" CssClass="form-control" MaxLength="2000" TextMode="MultiLine" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Status" Text="Status" /><asp:DropDownList ID="Status" runat="server" CssClass="form-select"><asp:ListItem>Active</asp:ListItem><asp:ListItem>Inactive</asp:ListItem></asp:DropDownList></div><asp:Button ID="SaveButton" runat="server" Text="Save category" CssClass="btn btn-primary" OnClick="SaveClick" CausesValidation="true" /> <asp:Button ID="ResetButton" runat="server" Text="Reset / add new" CssClass="btn btn-primary" OnClick="ResetClick" CausesValidation="false" /></div>
</asp:Content>
