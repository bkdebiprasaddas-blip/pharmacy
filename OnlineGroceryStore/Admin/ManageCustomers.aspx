<%@ Page Title="Manage customers" Language="VB" MasterPageFile="~/Admin/AdminMaster.master" AutoEventWireup="false" CodeFile="ManageCustomers.aspx.vb" Inherits="Admin_ManageCustomersPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<h1>Customers</h1><p>Deactivated accounts cannot log in or continue authenticated activity. Passwords are never displayed.</p><div class="filter-bar"><div class="field"><asp:Label runat="server" AssociatedControlID="Search" Text="Search name or email" /><asp:TextBox ID="Search" runat="server" CssClass="form-control" MaxLength="100" /></div><asp:Button ID="SaveButton" runat="server" Text="Search" CssClass="btn btn-primary" OnClick="SearchClick" CausesValidation="false" /></div><div class="table-responsive"><asp:GridView ID="CustomersGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." OnRowCommand="CustomerCommand"><Columns><asp:BoundField DataField="UserID" HeaderText="ID" /><asp:BoundField DataField="FullName" HeaderText="Name" /><asp:BoundField DataField="Email" HeaderText="Email" /><asp:BoundField DataField="Phone" HeaderText="Phone" /><asp:BoundField DataField="Address" HeaderText="Address" /><asp:BoundField DataField="City" HeaderText="City" /><asp:BoundField DataField="Status" HeaderText="Status" /><asp:TemplateField HeaderText="Account action"><ItemTemplate><asp:LinkButton runat="server" CommandName="ActivateCustomer" CommandArgument='<%# Eval("UserID") %>' Text="Activate" CausesValidation="false" /> · <asp:LinkButton runat="server" CommandName="DeactivateCustomer" CommandArgument='<%# Eval("UserID") %>' Text="Deactivate" CausesValidation="false" OnClientClick="return confirm('Deactivate this customer account?');" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div>
</asp:Content>
