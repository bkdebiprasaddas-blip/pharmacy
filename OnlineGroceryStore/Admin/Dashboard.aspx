<%@ Page Title="Store dashboard" Language="VB" MasterPageFile="~/Admin/AdminMaster.master" AutoEventWireup="false" CodeFile="Dashboard.aspx.vb" Inherits="Admin_DashboardPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading"><span class="eyebrow">STORE OVERVIEW</span><h1>Dashboard</h1><p>Your store, at a glance. Revenue counts delivered orders only.</p></div><asp:Repeater ID="Stats" runat="server"><HeaderTemplate><div class="stats-grid"></HeaderTemplate><ItemTemplate><article class="stat"><span><%#: Eval("Label") %></span><strong><%#: Eval("Value") %></strong></article></ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater><h2>Recent orders</h2><div class="table-responsive"><asp:GridView ID="RecentOrders" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." ><Columns><asp:BoundField DataField="OrderID" HeaderText="Order #" /><asp:BoundField DataField="FullName" HeaderText="Customer" /><asp:BoundField DataField="OrderDate" HeaderText="Date" DataFormatString="{0:dd MMM yyyy HH:mm}" /><asp:BoundField DataField="TotalAmount" HeaderText="Total" DataFormatString="{0:C2}" /><asp:BoundField DataField="PaymentMethod" HeaderText="Payment" /><asp:BoundField DataField="Status" HeaderText="Status" /></Columns></asp:GridView></div><div class="section-title"><h2>Low stock · 5 or fewer</h2><a href="ManageProducts.aspx">Manage inventory →</a></div><div class="table-responsive"><asp:GridView ID="LowStockGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." ><Columns><asp:BoundField DataField="ProductName" HeaderText="Product" /><asp:BoundField DataField="StockQuantity" HeaderText="Stock" /><asp:BoundField DataField="Status" HeaderText="Status" /></Columns></asp:GridView></div><h2>Top selling · delivered orders</h2><div class="table-responsive"><asp:GridView ID="TopProducts" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." ><Columns><asp:BoundField DataField="ProductName" HeaderText="Product" /><asp:BoundField DataField="UnitsSold" HeaderText="Units sold" /><asp:BoundField DataField="Revenue" HeaderText="Revenue" DataFormatString="{0:C2}" /></Columns></asp:GridView></div>
</asp:Content>
