<%@ Master Language="VB" %>
<!DOCTYPE html><html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>FreshBasket · Store management</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" /><link href="~/Content/site.css" runat="server" rel="stylesheet" /></head><body class="admin-body"><form id="AdminForm" runat="server"><input type="hidden" name="__csrf" value="<%: CType(Page, GroceryPage).CsrfToken %>" /><header class="site-header"><div class="header-inner"><a class="brand" href="Dashboard.aspx"><span class="brand-icon">✦</span> fresh<span>basket</span><small>STORE MANAGEMENT</small></a><div class="account-nav"><span><%: Convert.ToString(Session("UserName")) %></span><a href="<%= ResolveUrl("~/Default.aspx") %>">View store ↗</a><a href="<%= ResolveUrl("~/Logout.aspx") %>">Log out</a></div></div></header><div class="admin-shell"><aside><span class="eyebrow">WORKSPACE</span><nav aria-label="Administrator navigation"><a href="Dashboard.aspx">◫ &nbsp; Dashboard</a><a href="ManageCustomers.aspx">♙ &nbsp; Customers</a><a href="ManageCategories.aspx">▦ &nbsp; Categories</a><a href="ManageProducts.aspx">◇ &nbsp; Products</a><a href="ManageOrders.aspx">▤ &nbsp; Orders</a><a href="Reports.aspx">▥ &nbsp; Reports</a></nav><p class="muted">FreshBasket<br />Administrator area</p></aside><main id="main" class="admin-main"><% If CType(Page, GroceryPage).Notice.Length > 0 Then %><div class="notice" role="alert"><%: CType(Page, GroceryPage).Notice %></div><% End If %><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main></div></form></body></html>
