<%@ Page Title="Manage orders" Language="VB" MasterPageFile="~/Admin/AdminMaster.master" AutoEventWireup="false" CodeFile="ManageOrders.aspx.vb" Inherits="Admin_ManageOrdersPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<h1>Orders</h1><div class="filter-bar"><div class="field"><asp:Label runat="server" AssociatedControlID="FilterStatus" Text="Filter status" /><asp:DropDownList ID="FilterStatus" runat="server" CssClass="form-select"><asp:ListItem Value="">All orders</asp:ListItem><asp:ListItem>Pending</asp:ListItem><asp:ListItem>Confirmed</asp:ListItem><asp:ListItem>Packed</asp:ListItem><asp:ListItem>Out for Delivery</asp:ListItem><asp:ListItem>Delivered</asp:ListItem><asp:ListItem>Cancelled</asp:ListItem></asp:DropDownList></div><asp:Button ID="FilterButton" runat="server" Text="Filter orders" CssClass="btn btn-primary" OnClick="FilterClick" CausesValidation="false" /></div><div class="table-responsive"><asp:GridView ID="OrdersGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." OnRowCommand="OrderCommand"><Columns><asp:BoundField DataField="OrderID" HeaderText="Order #" /><asp:BoundField DataField="FullName" HeaderText="Customer" /><asp:BoundField DataField="Phone" HeaderText="Phone" /><asp:BoundField DataField="DeliveryAddress" HeaderText="Delivery address" /><asp:BoundField DataField="City" HeaderText="City" /><asp:BoundField DataField="OrderDate" HeaderText="Date" DataFormatString="{0:dd MMM yyyy HH:mm}" /><asp:BoundField DataField="TotalAmount" HeaderText="Total" DataFormatString="{0:C2}" /><asp:BoundField DataField="PaymentMethod" HeaderText="Payment" /><asp:BoundField DataField="Status" HeaderText="Status" /><asp:TemplateField HeaderText="Details"><ItemTemplate><asp:LinkButton runat="server" CommandName="ShowItems" CommandArgument='<%# Eval("OrderID") %>' Text="View items" CausesValidation="false" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div><h2><asp:Literal ID="ItemsHeading" runat="server" Mode="Encode" Text="Select an order to view items" /></h2><div class="table-responsive"><asp:GridView ID="ItemsGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." ><Columns><asp:BoundField DataField="ProductName" HeaderText="Product" /><asp:BoundField DataField="Unit" HeaderText="Unit" /><asp:BoundField DataField="Quantity" HeaderText="Quantity" /><asp:BoundField DataField="Price" HeaderText="Price" DataFormatString="{0:C2}" /><asp:BoundField DataField="Subtotal" HeaderText="Subtotal" DataFormatString="{0:C2}" /></Columns></asp:GridView></div><div class="form-panel"><h2>Update order status</h2><p>Pending → Confirmed → Packed → Out for Delivery → Delivered. Cancellation is only allowed before dispatch and restores stock once.</p><div class="field"><asp:Label runat="server" AssociatedControlID="OrderIdInput" Text="Order number" /><asp:TextBox ID="OrderIdInput" runat="server" CssClass="form-control" MaxLength="10" TextMode="Number" /><asp:RequiredFieldValidator runat="server" ControlToValidate="OrderIdInput" ErrorMessage="Order number is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="NextStatus" Text="New status" /><asp:DropDownList ID="NextStatus" runat="server" CssClass="form-select"><asp:ListItem>Pending</asp:ListItem><asp:ListItem>Confirmed</asp:ListItem><asp:ListItem>Packed</asp:ListItem><asp:ListItem>Out for Delivery</asp:ListItem><asp:ListItem>Delivered</asp:ListItem><asp:ListItem>Cancelled</asp:ListItem></asp:DropDownList></div><asp:Button ID="SaveButton" runat="server" Text="Update status" CssClass="btn btn-primary" OnClick="StatusClick" CausesValidation="true" /></div>
</asp:Content>
