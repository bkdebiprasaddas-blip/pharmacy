<%@ Page Title="Store reports" Language="VB" MasterPageFile="~/Admin/AdminMaster.master" AutoEventWireup="false" CodeFile="Reports.aspx.vb" Inherits="Admin_ReportsPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<h1>Reports</h1><p>Sales and orders use an inclusive date range. Revenue includes delivered orders only. Use your browser’s print dialog to save these reports as PDF.</p><div class="filter-bar"><div class="field"><asp:Label runat="server" AssociatedControlID="StartDate" Text="From" /><asp:TextBox ID="StartDate" runat="server" CssClass="form-control" MaxLength="100" TextMode="Date" /><asp:RequiredFieldValidator runat="server" ControlToValidate="StartDate" ErrorMessage="From is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="EndDate" Text="Through" /><asp:TextBox ID="EndDate" runat="server" CssClass="form-control" MaxLength="100" TextMode="Date" /><asp:RequiredFieldValidator runat="server" ControlToValidate="EndDate" ErrorMessage="Through is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Threshold" Text="Low-stock threshold" /><asp:TextBox ID="Threshold" runat="server" CssClass="form-control" MaxLength="7" TextMode="Number" /><asp:RequiredFieldValidator runat="server" ControlToValidate="Threshold" ErrorMessage="Low-stock threshold is required." Display="Dynamic" CssClass="validation" /></div><asp:Button ID="SaveButton" runat="server" Text="Apply filters" CssClass="btn btn-primary" OnClick="FilterClick" CausesValidation="true" /></div><h2>Sales &amp; orders</h2><p>Delivered revenue in range: <strong><asp:Literal ID="Revenue" runat="server" Mode="Encode" /></strong></p><div class="table-responsive"><asp:GridView ID="SalesGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." ><Columns><asp:BoundField DataField="OrderID" HeaderText="Order #" /><asp:BoundField DataField="OrderDate" HeaderText="Date" DataFormatString="{0:dd MMM yyyy}" /><asp:BoundField DataField="FullName" HeaderText="Customer" /><asp:BoundField DataField="TotalAmount" HeaderText="Total" DataFormatString="{0:C2}" /><asp:BoundField DataField="Status" HeaderText="Status" /></Columns></asp:GridView></div><h2>Low-stock inventory</h2><div class="table-responsive"><asp:GridView ID="LowStockGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." ><Columns><asp:BoundField DataField="ProductID" HeaderText="ID" /><asp:BoundField DataField="ProductName" HeaderText="Product" /><asp:BoundField DataField="StockQuantity" HeaderText="Stock" /><asp:BoundField DataField="Status" HeaderText="Status" /></Columns></asp:GridView></div><h2>Product inventory</h2><div class="table-responsive"><asp:GridView ID="ProductsGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." ><Columns><asp:BoundField DataField="ProductName" HeaderText="Product" /><asp:BoundField DataField="CategoryName" HeaderText="Category" /><asp:BoundField DataField="Price" HeaderText="Price" DataFormatString="{0:C2}" /><asp:BoundField DataField="StockQuantity" HeaderText="Stock" /><asp:BoundField DataField="Status" HeaderText="Status" /></Columns></asp:GridView></div>
</asp:Content>
