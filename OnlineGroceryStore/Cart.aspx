<%@ Page Title="Your basket" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeFile="Cart.aspx.vb" Inherits="CartPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading"><span class="eyebrow">GOOD THINGS INSIDE</span><h1>Your basket</h1><p>Change quantities and select Update. Stock and prices are checked again at checkout.</p></div><div class="table-responsive"><asp:GridView ID="CartGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." OnRowCommand="CartCommand"><Columns><asp:BoundField DataField="ProductName" HeaderText="Product" /><asp:BoundField DataField="Unit" HeaderText="Unit" /><asp:BoundField DataField="Quantity" HeaderText="Quantity" /><asp:BoundField DataField="Price" HeaderText="Price" DataFormatString="{0:C2}" /><asp:BoundField DataField="Subtotal" HeaderText="Subtotal" DataFormatString="{0:C2}" /><asp:TemplateField HeaderText="Update quantity"><ItemTemplate><asp:TextBox ID="Qty" runat="server" TextMode="Number" CssClass="form-control qty" Text='<%# Eval("Quantity") %>' aria-label="Quantity" /><asp:LinkButton runat="server" CommandName="SaveQty" CommandArgument='<%# Eval("CartID") %>' Text="Update" CausesValidation="false" /></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Action"><ItemTemplate><asp:LinkButton runat="server" CommandName="RemoveItem" CommandArgument='<%# Eval("CartID") %>' Text="Remove" CausesValidation="false" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div><div class="cart-summary"><h2>Total: <asp:Literal ID="TotalLabel" runat="server" Mode="Encode" /></h2><asp:HyperLink ID="CheckoutLink" runat="server" NavigateUrl="~/Checkout.aspx" CssClass="btn btn-primary" Text="Proceed to checkout →" /> <asp:Button ID="ClearButton" runat="server" Text="Clear cart" CssClass="btn btn-primary" OnClick="ClearClick" CausesValidation="false" /> <a href="Products.aspx">Continue shopping</a></div>
</asp:Content>
