<%@ Page Title="Fresh groceries, simply delivered" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeFile="Default.aspx.vb" Inherits="DefaultPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<section class="hero"><div><span class="eyebrow">YOUR EVERYDAY GROCERY STORE</span><h1>Fresh picks.<br />Happy kitchens.</h1><p>From pantry essentials to seasonal favourites. Fill your basket, choose your delivery address, and leave the rest to us.</p><a class="btn btn-primary btn-lg" href="Products.aspx">Shop groceries →</a><p class="hero-note">Everyday essentials · Clear pricing · Cash on Delivery</p></div><div class="hero-art"><img src="Content/grocery.svg" alt="Illustration of a basket of fresh groceries" /><span class="floating-label">A little freshness, every day.</span></div></section>
<section><div class="section-title"><div><span class="eyebrow">FIND YOUR FAVOURITES</span><h2>Shop by category</h2></div><a href="Products.aspx">View all products →</a></div><asp:Repeater ID="CategoryList" runat="server"><HeaderTemplate><div class="category-grid"></HeaderTemplate><ItemTemplate><a class="category-tile" href='<%# "Products.aspx?category=" & Eval("CategoryID").ToString() %>'><span>✦</span><%#: Eval("CategoryName") %><b>→</b></a></ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater></section>
<section><div class="section-title"><div><span class="eyebrow">GOOD FOOD STARTS HERE</span><h2>Fresh from our shelves</h2></div><a href="Products.aspx">Explore the store →</a></div><asp:Repeater ID="ProductList" runat="server"><HeaderTemplate><div class="product-grid"></HeaderTemplate><ItemTemplate>
<article class="product-card"><a href='<%# ResolveUrl("~/ProductDetails.aspx?id=" & Eval("ProductID").ToString()) %>'><img src='<%# CommonHelper.ProductImage(Eval("ImagePath")) %>' alt="Grocery product" loading="lazy" /></a><div class="product-card-body"><span class="eyebrow"><%#: Eval("CategoryName") %></span><h3><%#: Eval("ProductName") %></h3><p class="muted"><%#: Eval("Brand") %> · <%#: Eval("Unit") %></p><div class="price-row"><strong><%#: CommonHelper.FormatCurrency(Eval("Price")) %></strong><span><%#: Eval("StockQuantity") %> in stock</span></div><a class="btn btn-outline-primary" href='<%# ResolveUrl("~/ProductDetails.aspx?id=" & Eval("ProductID").ToString()) %>'>View &amp; add to cart →</a></div></article>
</ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater><asp:Label ID="EmptyLabel" runat="server" CssClass="muted" /></section><section class="benefits"><div><h3>Everyday essentials</h3><p>One place for your kitchen and home.</p></div><div><h3>Simple shopping</h3><p>Build your basket in just a few clicks.</p></div><div><h3>Know your order</h3><p>Follow its status from packing to delivery.</p></div></section>
</asp:Content>
