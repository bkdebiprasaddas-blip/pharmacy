<div class="form-panel narrow"><span class="eyebrow">GOOD TO SEE YOU AGAIN</span><h1>Welcome back</h1><p>Log in to shop or manage your store.</p><asp:ValidationSummary runat="server" CssClass="validation" /><div class="field"><asp:Label runat="server" AssociatedControlID="Email" Text="Email" /><asp:TextBox ID="Email" runat="server" CssClass="form-control" MaxLength="254" TextMode="Email" /><asp:RequiredFieldValidator runat="server" ControlToValidate="Email" ErrorMessage="Email is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Password" Text="Password" /><asp:TextBox ID="Password" runat="server" CssClass="form-control" MaxLength="128" TextMode="Password" /><asp:RequiredFieldValidator runat="server" ControlToValidate="Password" ErrorMessage="Password is required." Display="Dynamic" CssClass="validation" /></div><asp:Button ID="SaveButton" runat="server" Text="Log in" CssClass="btn btn-primary" OnClick="LoginClick" CausesValidation="true" /><p>New here? <a href="Register.aspx">Create an account</a></p></div>
</asp:Content>
