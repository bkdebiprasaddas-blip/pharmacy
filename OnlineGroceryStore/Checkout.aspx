<%@ Page Title="Checkout" Language="VB" MasterPageFile="~/Site.Master" AutoEventWireup="false" CodeFile="Checkout.aspx.vb" Inherits="CheckoutPage" %>
<asp:Content ID="MainContent" ContentPlaceHolderID="MainContent" runat="server">
<div class="page-heading"><span class="eyebrow">ONE LAST STEP</span><h1>Checkout</h1><p>Review your basket and tell us where to deliver.</p></div><div class="table-responsive"><asp:GridView ID="ItemsGrid" runat="server" AutoGenerateColumns="false" CssClass="table" GridLines="None" EmptyDataText="No records to display." ><Columns><asp:BoundField DataField="ProductName" HeaderText="Product" /><asp:BoundField DataField="Unit" HeaderText="Unit" /><asp:BoundField DataField="Quantity" HeaderText="Quantity" /><asp:BoundField DataField="Price" HeaderText="Price" DataFormatString="{0:C2}" /><asp:BoundField DataField="Subtotal" HeaderText="Subtotal" DataFormatString="{0:C2}" /></Columns></asp:GridView></div><div class="form-panel"><h2>Total: <asp:Literal ID="TotalLabel" runat="server" Mode="Encode" /></h2><p>No delivery fee is charged in this demonstration. The final total uses current prices at submission.</p><asp:ValidationSummary runat="server" CssClass="validation" /><div class="field"><asp:Label runat="server" AssociatedControlID="Address" Text="Delivery address" /><asp:TextBox ID="Address" runat="server" CssClass="form-control" MaxLength="1000" TextMode="MultiLine" /><asp:RequiredFieldValidator runat="server" ControlToValidate="Address" ErrorMessage="Delivery address is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="City" Text="City" /><asp:TextBox ID="City" runat="server" CssClass="form-control" MaxLength="100" /><asp:RequiredFieldValidator runat="server" ControlToValidate="City" ErrorMessage="City is required." Display="Dynamic" CssClass="validation" /></div><div class="field"><asp:Label runat="server" AssociatedControlID="Payment" Text="Payment method" /><asp:DropDownList ID="Payment" runat="server" CssClass="form-select"><asp:ListItem>Cash on Delivery</asp:ListItem></asp:DropDownList><small>Online payments are not integrated. Pay when your order arrives.</small></div><asp:Button ID="SaveButton" runat="server" Text="Place order" CssClass="btn btn-primary" OnClick="PlaceClick" CausesValidation="true" /></div>
</asp:Content>
