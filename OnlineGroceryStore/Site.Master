<%@ Master Language="VB" %>
<!DOCTYPE html>
<html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>FreshBasket</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" /><link href="~/Content/site.css" rel="stylesheet" runat="server" /></head>
<body><div class="announcement">Fresh essentials. Thoughtful shopping. <span>Cash on Delivery available</span></div>
<form id="StoreForm" runat="server"><input type="hidden" name="__csrf" value="<%: CType(Page, GroceryPage).CsrfToken %>" />
<header class="site-header"><div class="header-inner"><a class="brand" href="<%= ResolveUrl("~/Default.aspx") %>"><span class="brand-icon">✦</span> fresh<span>basket</span><small>EVERYDAY GOODNESS</small></a><nav aria-label="Main navigation"><a href="<%= ResolveUrl("~/Default.aspx") %>">Home</a><a href="<%= ResolveUrl("~/Products.aspx") %>">Products</a><a href="<%= ResolveUrl("~/Cart.aspx") %>">Cart</a><a href="<%= ResolveUrl("~/Orders.aspx") %>">My orders</a><a href="<%= ResolveUrl("~/About.aspx") %>">About</a><a href="<%= ResolveUrl("~/Contact.aspx") %>">Contact</a></nav><div class="account-nav">
<% If CType(Page, GroceryPage).UserId > 0 Then %><span class="welcome">Hi, <%: Convert.ToString(Session("UserName")) %></span><% If CType(Page, GroceryPage).IsAdmin Then %><a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>">Admin</a><% End If %><a href="<%= ResolveUrl("~/Logout.aspx") %>">Log out</a><% Else %><a href="<%= ResolveUrl("~/Login.aspx") %>">Log in</a><a class="btn btn-primary" href="<%= ResolveUrl("~/Register.aspx") %>">Sign up</a><% End If %>
</div></div></header>
<main id="main" class="container store-main"><% If CType(Page, GroceryPage).Notice.Length > 0 Then %><div class="notice" role="alert"><%: CType(Page, GroceryPage).Notice %></div><% End If %><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
<footer><div class="container footer-inner"><div><strong>✦ freshbasket</strong><p>Good food. Everyday essentials. One happy basket.</p></div><div><a href="<%= ResolveUrl("~/About.aspx") %>">About us</a> · <a href="<%= ResolveUrl("~/Contact.aspx") %>">Contact</a><p>Academic demonstration · OnlineGroceryStore</p></div></div></footer></form></body></html>
